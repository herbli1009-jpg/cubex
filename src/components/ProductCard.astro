---
import { categoryLabel } from '../lib/content-taxonomy';
const { product } = Astro.props;
const category = categoryLabel(product.id.split('/').slice(0, -1).join('/'));
---
<article class="card product-card" data-search={`${product.data.name} ${product.data.description}`.toLowerCase()}><img src={product.data.image} alt={product.data.name} loading="lazy" /><div class="card-body"><small>{category} · {product.data.status}</small><h3>{product.data.name}</h3><p>{product.data.description}</p><br /><a class="btn" href={`/products/${product.id.split('/').at(-1)}`}>View Product</a></div></article>
