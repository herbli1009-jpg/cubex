---
const { source = 'contact' } = Astro.props;
---
<form id="lead-form"><input type="hidden" name="source" value={source} /><input class="honeypot" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" /><div class="field"><label for="name">Name</label><input id="name" required name="name" maxlength="100" /></div><div class="field"><label for="company">Company</label><input id="company" name="company" maxlength="120" /></div><div class="field"><label for="email">Email</label><input id="email" required type="email" name="email" /></div><div class="field"><label for="country">Country / Region</label><input id="country" name="country" maxlength="120" /></div><div class="field full"><label for="service">What do you need?</label><select id="service" name="service"><option>Buy Products</option><option>Develop A New Product</option><option>China Sourcing & Procurement Agency</option><option>Quality Control Support</option><option>Not Sure - Need Advice</option></select></div><div class="field full"><label for="priority">Primary Priority</label><select id="priority" name="priority"><option>Product quality</option><option>Total cost reduction</option><option>Faster development</option><option>Delivery reliability</option><option>Supplier management</option></select></div><div class="field full"><label for="details">Project Details</label><textarea id="details" required name="details" minlength="10" maxlength="5000" placeholder="Products, quantities, current challenges, target market and expected timing."></textarea></div><div class="field full"><button class="btn btn-primary" type="submit">Submit Inquiry</button><p class="form-note" aria-live="polite"></p></div></form>
<script>
  const form = document.querySelector<HTMLFormElement>('#lead-form'); const params = new URLSearchParams(location.search); const product = params.get('product'); const resource = params.get('resource'); const answers = sessionStorage.getItem('cubexQuestionnaire'); const note = form?.querySelector<HTMLElement>('.form-note');
  if (product) { const details = form?.elements.namedItem('details') as HTMLTextAreaElement; if (details) details.value = `I am interested in: ${product}\n`; }
  if (resource) { const details = form?.elements.namedItem('details') as HTMLTextAreaElement; if (details) details.value = `I would like to request: ${resource}\n`; }
  if (answers) { const details = form?.elements.namedItem('details') as HTMLTextAreaElement; if (details) details.value = `Questionnaire Summary:\n${Object.entries(JSON.parse(answers)).map(([key, value]) => `${key}: ${value}`).join('\n')}\n\nAdditional Notes:\n`; }
  form?.addEventListener('submit', async event => { event.preventDefault(); if (!form || !note) return; const data = Object.fromEntries(new FormData(form)); const payload = { ...data, product: product || undefined, resource: resource || undefined, questionnaire: answers ? JSON.parse(answers) : undefined, honeypot: data.website || undefined, turnstileToken: (window as any).turnstile?.getResponse?.() || undefined }; note.className = 'form-note'; note.textContent = 'Sending inquiry...'; try { const response = await fetch('/api/inquiries', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) }); const result = await response.json(); if (!response.ok) throw new Error(result.message || 'Unable to send your inquiry.'); note.textContent = `Thank you. Your inquiry reference is ${result.id}.`; form.reset(); sessionStorage.removeItem('cubexQuestionnaire'); } catch (error) { note.className = 'form-note error'; note.textContent = error instanceof Error ? error.message : 'Unable to send your inquiry.'; } });
</script>
