---
const { features } = Astro.props;
---
<div class="feature-grid">{features.map((feature: { title: string; description: string }, index: number) => <section class="feature"><span class="feature-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><div class="feature-content"><h3>{feature.title}</h3><p>{feature.description}</p></div></section>)}</div>
