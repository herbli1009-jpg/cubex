---
import { getCollection } from 'astro:content'; import Base from '../../layouts/Base.astro'; import Hero from '../../components/Hero.astro'; import ProductCard from '../../components/ProductCard.astro'; import { buildCategoryTree } from '../../lib/content-taxonomy';
const products = await getCollection('products');
const categories = buildCategoryTree('products', products);
---
<Base title="Fitness Equipment Products | CUBEX"><Hero eyebrow="Product Center" title="Products." description="Explore CUBEX strength, functional training, free-weight and commercial gym products. Each product can be customized for your brand and target market." /><section class="section"><div class="container"><div class="category-index">{categories.map((category) => <a class="category-index-item" href={category.url}><span>{category.label}</span><small>{category.children.length ? `${category.children.length} subcategories` : 'Browse products'}</small></a>)}</div><div class="toolbar"><input class="search" aria-label="Search products" placeholder="Search all products..." /></div><div class="grid" id="product-grid">{products.map(product => <ProductCard {product} />)}</div></div></section><script>const search=document.querySelector<HTMLInputElement>('.search');const cards=document.querySelectorAll<HTMLElement>('.product-card');const render=()=>{const q=search?.value.toLowerCase()||'';cards.forEach(card=>card.hidden=!(card.dataset.search||'').includes(q))};search?.addEventListener('input',render);</script></Base>
