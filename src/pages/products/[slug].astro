---
import { getCollection, getEntry, render } from 'astro:content'; import Base from '../../layouts/Base.astro'; import Hero from '../../components/Hero.astro'; import ProductCard from '../../components/ProductCard.astro'; import CopyMarkdown from '../../components/CopyMarkdown.astro';
const product = await getEntry('products', Astro.params.slug!); if (!product) return new Response(null, { status: 404 }); const related = (await getCollection('products')).filter(item => item.id !== product.id).slice(0, 3); const { Content } = await render(product);
---
<Base title={`${product.data.name} | CUBEX`} description={product.data.description} image={product.data.image}><Hero eyebrow={`${product.data.category} · ${product.data.status}`} title={product.data.name} description={product.data.description} actions={[{href:`/contact?product=${encodeURIComponent(product.data.name)}`,label:'Request Quote',primary:true},{href:'/products',label:'All Products'}]} /><section class="section"><div class="container detail"><img src={product.data.image} alt={product.data.name} /><h2>Product Overview</h2><p>{product.data.description}</p><Content /><CopyMarkdown markdown={product.body || ''} /><h2>Specifications</h2><div class="specs">{product.data.specs.map(spec => <div class="spec"><strong>{spec.label}</strong><span>{spec.value}</span></div>)}</div><h2>Customization</h2><p>{product.data.customization}</p></div></section><section class="section"><div class="container"><p class="eyebrow">Related Products</p><h2 class="section-title">Explore More.</h2><div class="grid">{related.map(product => <ProductCard {product} />)}</div></div></section></Base>
