---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import ProductCard from '../../components/ProductCard.astro';
import CopyMarkdown from '../../components/CopyMarkdown.astro';
import { buildCategoryTree, categoryLabel, categoryPath, entriesInCategory, relatedEntries } from '../../lib/content-taxonomy';

const products = await getCollection('products');
const path = Astro.params.path!;
const product = products.find((entry) => entry.id.split('/').at(-1) === path);
const categories = buildCategoryTree('products', products);
const findCategory = (value: string) => value.split('/').reduce<typeof categories[number] | undefined>((current, segment, index) => index === 0 ? categories.find((item) => item.path === segment) : current?.children.find((item) => item.path === `${current.path}/${segment}`), undefined);
const category = product ? undefined : findCategory(path);
if (!product && !category) return new Response(null, { status: 404 });
const productCategoryPath = product ? categoryPath(product) : '';
const productCategoryName = product ? categoryLabel(productCategoryPath) : '';
const related = product ? relatedEntries(products, product) : [];
const categoryItems = category ? entriesInCategory(products, category.path) : [];
const rendered = product ? await render(product) : undefined;
const Content = rendered?.Content;
---
{product ? <Base title={`${product.data.name} | CUBEX`} description={product.data.description} image={product.data.image}><Hero eyebrow={`${productCategoryName} · ${product.data.status}`} title={product.data.name} description={product.data.description} actions={[{href:`/contact?product=${encodeURIComponent(product.data.name)}`,label:'Request Quote',primary:true},{href:`/products/${productCategoryPath}/`,label:productCategoryName}]} /><section class="section"><div class="container detail"><p class="breadcrumbs"><a href="/products">Products</a><span>/</span>{productCategoryPath.split('/').map((_, index, segments) => <a href={`/products/${segments.slice(0, index + 1).join('/')}/`}>{categoryLabel(segments.slice(0, index + 1).join('/'))}</a>)}</p><img src={product.data.image} alt={product.data.name} /><h2>Product Overview</h2><p>{product.data.description}</p>{Content && <Content />}<CopyMarkdown markdown={product.body || ''} /><h2>Specifications</h2><div class="specs">{product.data.specs.map(spec => <div class="spec"><strong>{spec.label}</strong><span>{spec.value}</span></div>)}</div><h2>Customization</h2><p>{product.data.customization}</p></div></section>{related.length > 0 && <section class="section"><div class="container"><p class="eyebrow">Related Products</p><h2 class="section-title">Explore More.</h2><div class="grid">{related.map((item) => <ProductCard product={item} />)}</div></div></section>}</Base> : category && <Base title={`${categoryLabel(category.path)} | CUBEX`} description={`Browse CUBEX ${categoryLabel(category.path)} products.`}><Hero eyebrow="Product Category" title={`${categoryLabel(category.path)}.`} description={`Browse CUBEX ${categoryLabel(category.path)} products and subcategories.`} actions={[{href:'/products',label:'All Products'}]} /><section class="section"><div class="container"><p class="breadcrumbs"><a href="/products">Products</a><span>/</span>{category.path.split('/').map((_, index, segments) => <a href={`/products/${segments.slice(0, index + 1).join('/')}/`}>{categoryLabel(segments.slice(0, index + 1).join('/'))}</a>)}</p>{category.children.length > 0 && <div class="category-index">{category.children.map((child) => <a class="category-index-item" href={child.url}><span>{child.label}</span><small>{entriesInCategory(products, child.path).length} products</small></a>)}</div>}<div class="grid">{categoryItems.map((item) => <ProductCard product={item} />)}</div></div></section></Base>}
