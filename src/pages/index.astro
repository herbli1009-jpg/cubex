---
import { getCollection } from 'astro:content'; import Base from '../layouts/Base.astro'; import Hero from '../components/Hero.astro'; import ProductCard from '../components/ProductCard.astro'; import ArticleCard from '../components/ArticleCard.astro'; import FeatureGrid from '../components/FeatureGrid.astro';
const products = (await getCollection('products'))
  .filter(p => p.data.featured || p.data.status === 'New')
  .sort((a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf());
const articles = (await getCollection('articles')).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const features = [{title:'Product Engineering',description:'Concept definition, structural design, DFM, cost engineering, prototypes and production launch.'},{title:'Quality Control',description:'Supplier qualification, IQC, IPQC, functional testing, packaging inspection and corrective actions.'},{title:'China Sourcing',description:'Supplier development, negotiation, cost reduction, order control and multi-factory coordination.'},{title:'Knowledge & Resources',description:'Buying guides, engineering insights, quality methods, catalogs, manuals and technical downloads.'}];
---
<Base title="CUBEX | Fitness Equipment Engineering & China Sourcing"><Hero home eyebrow="Fitness Equipment Product & Supply Chain Platform" title={'Build Better.\nSource Smarter.'} description="CUBEX combines product engineering, quality control, fitness equipment manufacturing and China sourcing support to help global brands reduce total cost and supply-chain risk." image="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&w=2000&q=85" actions={[{href:'/products',label:'Explore Products',primary:true},{href:'/questionnaire',label:'Start Questionnaire'},{href:'/contact',label:'Contact Us'}]} /><section class="section"><div class="container"><p class="eyebrow">Latest Innovation</p><h2 class="section-title">New Products.</h2><div class="grid">{products.map(product => <ProductCard {product} />)}</div></div></section><section class="section"><div class="container"><p class="eyebrow">What We Do</p><h2 class="section-title">One Team. Full Supply Chain.</h2><FeatureGrid {features} /></div></section><section class="section"><div class="container"><p class="eyebrow">Insights</p><h2 class="section-title">Knowledge Center.</h2><div class="grid">{articles.map(article => <ArticleCard {article} />)}</div></div></section></Base>
