---
import { getCollection } from 'astro:content'; import Base from '../../layouts/Base.astro'; import Hero from '../../components/Hero.astro'; import ArticleCard from '../../components/ArticleCard.astro';
const articles = (await getCollection('articles')).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf()); const categories = ['All', ...new Set(articles.map(a => a.data.category))];
---
<Base title="Fitness Equipment Knowledge Center | CUBEX"><Hero eyebrow="Knowledge Center" title="Insights That Improve Decisions." description="Buying guides, engineering knowledge, quality methods and China sourcing insights organized around customer questions." /><section class="section"><div class="container"><div class="toolbar"><div class="filters">{categories.map((category, i) => <button class:list={['filter', i === 0 && 'active']} data-article-filter={category}>{category}</button>)}</div><input class="search" aria-label="Search knowledge" placeholder="Search articles..." /></div><div class="grid" id="article-grid">{articles.map(article => <div class="article-item" data-category={article.data.category} data-search={`${article.data.title} ${article.data.excerpt} ${article.data.keywords.join(' ')}`.toLowerCase()}><ArticleCard {article} /></div>)}</div></div></section><script>const filters=document.querySelectorAll<HTMLButtonElement>('[data-article-filter]');const search=document.querySelector<HTMLInputElement>('.search');const cards=document.querySelectorAll<HTMLElement>('.article-item');let active='All';const render=()=>{const q=search?.value.toLowerCase()||'';cards.forEach(card=>card.hidden=!((active==='All'||card.dataset.category===active)&&(card.dataset.search||'').includes(q)))};filters.forEach(button=>button.addEventListener('click',()=>{active=button.dataset.articleFilter||'All';filters.forEach(x=>x.classList.toggle('active',x===button));render()}));search?.addEventListener('input',render);</script></Base>
