---
import { getCollection } from 'astro:content'; import Base from '../../layouts/Base.astro'; import Hero from '../../components/Hero.astro'; import ArticleCard from '../../components/ArticleCard.astro'; import { buildCategoryTree } from '../../lib/content-taxonomy';
const articles = (await getCollection('articles')).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf()); const categories = buildCategoryTree('articles', articles);
---
<Base title="Fitness Equipment Knowledge Center | CUBEX"><Hero eyebrow="Knowledge Center" title="Insights That Improve Decisions." description="Buying guides, engineering knowledge, quality methods and China sourcing insights organized around customer questions." /><section class="section"><div class="container"><div class="category-index">{categories.map((category) => <a class="category-index-item" href={category.url}><span>{category.label}</span><small>{category.children.length ? `${category.children.length} subcategories` : 'Browse articles'}</small></a>)}</div><div class="toolbar"><input class="search" aria-label="Search knowledge" placeholder="Search all articles..." /></div><div class="grid" id="article-grid">{articles.map(article => <div class="article-item" data-search={`${article.data.title} ${article.data.excerpt} ${article.data.keywords.join(' ')}`.toLowerCase()}><ArticleCard {article} /></div>)}</div></div></section><script>const search=document.querySelector<HTMLInputElement>('.search');const cards=document.querySelectorAll<HTMLElement>('.article-item');const render=()=>{const q=search?.value.toLowerCase()||'';cards.forEach(card=>card.hidden=!(card.dataset.search||'').includes(q))};search?.addEventListener('input',render);</script></Base>
