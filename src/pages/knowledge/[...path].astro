---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { buildCategoryTree, categoryLabel, categoryPath, entriesInCategory } from '../../lib/content-taxonomy';

const articles = await getCollection('articles');
const path = Astro.params.path!;
const article = articles.find((entry) => entry.id.split('/').at(-1) === path);
const categories = buildCategoryTree('articles', articles);
const findCategory = (value: string) => value.split('/').reduce<typeof categories[number] | undefined>((current, segment, index) => index === 0 ? categories.find((item) => item.path === segment) : current?.children.find((item) => item.path === `${current.path}/${segment}`), undefined);
const category = article ? undefined : findCategory(path);
if (!article && !category) return new Response(null, { status: 404 });
const articleCategoryPath = article ? categoryPath(article) : '';
const articleCategoryName = article ? categoryLabel(articleCategoryPath) : '';
const categoryItems = category ? entriesInCategory(articles, category.path).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()) : [];
const rendered = article ? await render(article) : undefined;
const Content = rendered?.Content;
---
{article ? <Base title={article.data.seoTitle || `${article.data.title} | CUBEX`} description={article.data.seoDescription || article.data.excerpt} image={article.data.image} keywords={article.data.keywords} type="article" publishedTime={article.data.date.toISOString()}><script type="application/ld+json" set:html={JSON.stringify({ '@context':'https://schema.org', '@type':'Article', headline:article.data.title, description:article.data.seoDescription || article.data.excerpt, image:article.data.image, datePublished:article.data.date.toISOString(), dateModified:article.data.date.toISOString(), author:{ '@type':'Organization', name:'CUBEX' }, publisher:{ '@type':'Organization', name:'CUBEX' } })} /><Hero eyebrow={`${articleCategoryName} · ${article.data.date.toLocaleDateString('en-CA')} · ${article.data.readTime}`} title={article.data.title} description={article.data.excerpt} /><section class="section"><article class="container detail"><p class="breadcrumbs"><a href="/knowledge">Knowledge</a><span>/</span>{articleCategoryPath.split('/').map((_, index, segments) => <a href={`/knowledge/${segments.slice(0, index + 1).join('/')}/`}>{categoryLabel(segments.slice(0, index + 1).join('/'))}</a>)}</p><img src={article.data.image} alt={article.data.title} />{Content && <Content />}<h2>Discuss Your Project</h2><p>Contact CUBEX for product, engineering, quality or China sourcing support.</p><a class="btn btn-primary" href="/contact">Contact CUBEX</a></article></section></Base> : category && <Base title={`${categoryLabel(category.path)} Knowledge | CUBEX`} description={`CUBEX knowledge articles about ${categoryLabel(category.path)}.`}><Hero eyebrow="Knowledge Category" title={`${categoryLabel(category.path)}.`} description={`Explore CUBEX articles about ${categoryLabel(category.path)}.`} actions={[{href:'/knowledge',label:'All Articles'}]} /><section class="section"><div class="container"><p class="breadcrumbs"><a href="/knowledge">Knowledge</a><span>/</span>{category.path.split('/').map((_, index, segments) => <a href={`/knowledge/${segments.slice(0, index + 1).join('/')}/`}>{categoryLabel(segments.slice(0, index + 1).join('/'))}</a>)}</p>{category.children.length > 0 && <div class="category-index">{category.children.map((child) => <a class="category-index-item" href={child.url}><span>{child.label}</span><small>{entriesInCategory(articles, child.path).length} articles</small></a>)}</div>}<div class="grid">{categoryItems.map((item) => <ArticleCard article={item} />)}</div></div></section></Base>}
