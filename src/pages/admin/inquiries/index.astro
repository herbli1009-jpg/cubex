---
import { getAdminSessionUserId } from '../../../lib/admin-auth';
import { getAdminClient } from '../../../lib/admin-users';
export const prerender = false;
if (!getAdminSessionUserId(Astro.cookies, import.meta.env)) return Astro.redirect('/admin/inquiries/login');
if (!import.meta.env.SUPABASE_URL || !import.meta.env.SUPABASE_SERVICE_ROLE_KEY) return new Response('Supabase is not configured.', { status: 500 });
const supabase = getAdminClient(import.meta.env);
const { data: inquiries, error } = await supabase.from('inquiries').select('id,name,company,email,country,service,priority,details,source,product,resource,questionnaire,status,created_at,handled_at').order('created_at', { ascending: false }).limit(200);
if (error) return new Response('Unable to load inquiries.', { status: 500 });
const rows = inquiries ?? [];
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Inquiries | CUBEX</title><meta name="robots" content="noindex,nofollow" /><link rel="stylesheet" href="/admin.css" /></head><body><main class="admin-shell"><header class="admin-header"><div><p class="admin-kicker">CUBEX</p><h1>Inquiries</h1><p>{rows.length} most recent submissions</p></div><button id="sign-out" class="quiet-button" type="button">Sign out</button></header><div class="admin-toolbar"><input id="search" type="search" placeholder="Search name, email, company..." /><select id="status-filter"><option value="all">All statuses</option><option value="new">New</option><option value="in_progress">In progress</option><option value="closed">Closed</option><option value="spam">Spam</option></select></div><section class="inquiry-list">{rows.length ? rows.map((inquiry) => <details class="inquiry" data-status={inquiry.status} data-search={`${inquiry.name} ${inquiry.email} ${inquiry.company ?? ''} ${inquiry.service}`.toLowerCase()}><summary><span class={`status ${inquiry.status}`}>{inquiry.status.replace('_', ' ')}</span><strong>{inquiry.name}</strong><span>{inquiry.company || inquiry.email}</span><time datetime={inquiry.created_at}>{new Date(inquiry.created_at).toLocaleString('en-CA')}</time></summary><div class="inquiry-body"><div class="inquiry-meta"><div><small>Email</small><a href={`mailto:${inquiry.email}`}>{inquiry.email}</a></div><div><small>Company</small><span>{inquiry.company || '-'}</span></div><div><small>Country / Region</small><span>{inquiry.country || '-'}</span></div><div><small>Service</small><span>{inquiry.service}</span></div><div><small>Priority</small><span>{inquiry.priority}</span></div><div><small>Source</small><span>{inquiry.source}</span></div>{inquiry.product && <div><small>Product</small><span>{inquiry.product}</span></div>}{inquiry.resource && <div><small>Resource</small><span>{inquiry.resource}</span></div>}</div><div class="message"><small>Project details</small><p>{inquiry.details}</p></div>{Object.keys(inquiry.questionnaire || {}).length > 0 && <div class="message"><small>Questionnaire</small><pre>{JSON.stringify(inquiry.questionnaire, null, 2)}</pre></div>}<div class="status-control"><label>Status <select data-inquiry-id={inquiry.id} class="status-select"><option value="new" selected={inquiry.status === 'new'}>New</option><option value="in_progress" selected={inquiry.status === 'in_progress'}>In progress</option><option value="closed" selected={inquiry.status === 'closed'}>Closed</option><option value="spam" selected={inquiry.status === 'spam'}>Spam</option></select></label><span class="update-note" aria-live="polite"></span></div></div></details>) : <p class="empty">No inquiries have been submitted yet.</p>}</section></main><script>
const search = document.querySelector<HTMLInputElement>('#search'); const filter = document.querySelector<HTMLSelectElement>('#status-filter'); const rows = [...document.querySelectorAll<HTMLElement>('.inquiry')];
function applyFilters() { if (!search || !filter) return; const term = search.value.toLowerCase().trim(); const status = filter.value; rows.forEach((row) => { row.hidden = !((row.dataset.search || '').includes(term) && (status === 'all' || row.dataset.status === status)); }); }
search?.addEventListener('input', applyFilters); filter?.addEventListener('change', applyFilters);
document.querySelectorAll<HTMLSelectElement>('.status-select').forEach((select) => select.addEventListener('change', async () => { const row = select.closest<HTMLElement>('.inquiry'); const note = select.closest('.status-control')?.querySelector<HTMLElement>('.update-note'); const badge = row?.querySelector<HTMLElement>('.status'); if (!row || !note || !badge) return; note.textContent = 'Saving...'; const response = await fetch(`/api/admin/inquiries/${select.dataset.inquiryId}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status: select.value }) }); if (response.ok) { row.dataset.status = select.value; badge.className = `status ${select.value}`; badge.textContent = select.value.replace('_', ' '); note.textContent = 'Saved.'; applyFilters(); } else { note.textContent = 'Unable to save.'; } }));
document.querySelector('#sign-out')?.addEventListener('click', async () => { await fetch('/api/admin/session', { method: 'DELETE' }); location.assign('/admin/inquiries/login'); });
</script></body></html>
