---
import Base from '../layouts/Base.astro'; import Hero from '../components/Hero.astro';
---
<Base title="Project Questionnaire | CUBEX"><Hero eyebrow="Guided Project Discovery" title="Tell Us What You Need." description="Complete a short guided questionnaire. Your answers will be transferred to the contact form automatically." /><section class="section"><div class="container quiz-shell"><div class="quiz-card"><span class="tag" id="step-label">Step 1</span><div class="quiz-progress"><span id="progress"></span></div><div id="quiz"></div><div class="quiz-nav"><button class="btn" id="back" type="button">Back</button><button class="btn btn-primary" id="next" type="button">Next</button></div></div></div></section><script>
// @ts-nocheck
const product=[['category','Which product category?',['Strength Equipment','Free Weights','Functional Training','Benches & Storage']],['stage','What stage is the project?',['Early Idea','Comparing Suppliers','Sample Development','Ready For Order']],['volume','Expected order size?',['Trial Order','One Container','Multiple Containers','Annual Program']],['market','Target market?',['United Kingdom / Europe','United States / Canada','Middle East','Other Markets']],['priority','What matters most?',['Product Quality','Competitive Cost','Fast Development','Reliable Delivery']],['timeline','When should it start?',['Immediately','Within 1 Month','Within 3 Months','Still Planning']]];
const sourcing=[['model','Current sourcing model?',['Direct From Factories','Through Trading Companies','Mixed Supplier Base','New To China Sourcing']],['challenge','Biggest current challenge?',['High Total Cost','Quality Problems','Delivery Delays','Poor Communication']],['support','Which support is required?',['Supplier Search','Negotiation & Cost Down','Order Management','Full-Service Support']],['volume','Annual purchasing volume?',['Under $500K','$500K-$2M','$2M-$5M','Above $5M']],['suppliers','How many suppliers?',['1-3','4-10','11-20','More Than 20']],['timeline','When should cooperation begin?',['Immediately','Within 1 Month','Within 3 Months','Exploring Options']]];
let questions=[['path','How can CUBEX help?',['Buy Or Develop Products','China Sourcing & Procurement']]],step=0,answers={},selected='';const quiz=document.querySelector('#quiz'),label=document.querySelector('#step-label'),progress=document.querySelector('#progress'),back=document.querySelector('#back'),next=document.querySelector('#next');
function render(){if(step>=questions.length){label.textContent='Complete';progress.style.width='100%';quiz.innerHTML=`<p class="eyebrow">Project Summary</p><h2>Your Requirements Are Ready.</h2><p class="section-copy">Continue to Contact. Your answers will be included automatically.</p><div class="quiz-summary">${Object.entries(answers).map(([k,v])=>`<div class="spec"><strong>${k}</strong><span>${v}</span></div>`).join('')}</div><div class="actions"><a class="btn btn-primary" href="/contact?from=questionnaire" id="continue">Continue To Contact</a><button class="btn" id="restart">Restart</button></div>`;document.querySelector('#continue').onclick=()=>sessionStorage.setItem('cubexQuestionnaire',JSON.stringify(answers));document.querySelector('#restart').onclick=()=>{questions=[questions[0]];answers={};step=0;render()};back.style.display='none';next.style.display='none';return}const [key,title,options]=questions[step];selected=answers[key]||'';label.textContent=`Step ${step+1} of ${questions.length}`;progress.style.width=`${(step+1)/questions.length*100}%`;quiz.innerHTML=`<p class="eyebrow">Project Questionnaire</p><h2>${title}</h2><div class="quiz-options">${options.map(option=>`<button class="quiz-option ${selected===option?'selected':''}" data-option="${option}">${option}</button>`).join('')}</div>`;quiz.querySelectorAll('.quiz-option').forEach(button=>button.onclick=()=>{selected=button.dataset.option;quiz.querySelectorAll('.quiz-option').forEach(x=>x.classList.toggle('selected',x===button))});back.style.visibility=step?'visible':'hidden'}next.onclick=()=>{if(!selected)return;const [key]=questions[step];answers[key]=selected;if(step===0)questions=[questions[0],...(selected.includes('Products')?product:sourcing)];step++;render()};back.onclick=()=>{if(step){step--;render()}};render();
</script></Base>
