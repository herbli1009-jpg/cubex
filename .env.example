PUBLIC_SITE_URL=https://cubex-fitness.com
PUBLIC_MEDIA_URL=https://media.cubex-fitness.com
# Create a Turnstile widget for this domain, then configure its site key and secret together.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Project URL only, for example https://your-project.supabase.co (do not append /rest/v1)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=website@cubex-fitness.com
INQUIRY_RECIPIENT=hello@cubexfitness.com
# Used by the legacy admin session scheme. The current Supabase-verified session does not require it.
ADMIN_SESSION_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Comma-separated Tina admin origins allowed to upload directly to R2.
MEDIA_UPLOAD_ORIGINS=https://cubex-fitness.com,http://localhost:4321
TINA_CLIENT_ID=
TINA_TOKEN=
TINA_SEARCH_TOKEN=
